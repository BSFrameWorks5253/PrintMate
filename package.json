{
  "name": "printmate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "cross-env BUILD_TARGET=electron npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.printmate.studio",
    "productName": "PrintMate Studio",
    "electronVersion": "22.3.27",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/downloads/**/*",
      "electron/**/*",
      "package.json"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PrintMate Studio"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jszip": "^3.4.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dxf-parser": "^1.1.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "jpeg-js": "^0.4.4",
    "oxlint": "^1.88.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
